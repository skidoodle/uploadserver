<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<link rel="icon" href="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
		<title>uploadserver · {{ .Token.Label }} uploads</title>
		<link rel="stylesheet" href="/_/uploads/css/uploads.bundle.css" />
	</head>
	<body>
		<h1>uploadserver</h1>
		<nav class="breadcrumb">
			<a href="/">dashboard</a>
			<span class="sep">›</span>
			<span>uploads</span>
			<span class="sep">›</span>
			<span>{{ .Token.ID }}</span>
		</nav>

		{{ if .Notice }}
			<div class="notice">{{ .Notice }}</div>
		{{ end }}
		{{ if .Error }}
			<p id="msg" class="err">{{ .Error }}</p>
		{{ end }}

		{{ if .PendingPurge }}
			<div class="purge-banner">
				<span>Media purge scheduled in <strong>{{ timeUntil .PendingPurge.PurgeAt }}</strong> ({{ fmtDate .PendingPurge.PurgeAt }})</span>
				<form method="POST" action="/_/tokens/{{ .Token.ID }}/cancel-purge">
					<input type="hidden" name="_csrf" value="{{ .CSRF }}">
					<button type="submit" class="act">Cancel purge</button>
				</form>
			</div>
		{{ end }}

		<div class="toolbar-bar">
			<div class="summary-bar">
				{{ if gt .TotalUnfiltered 0 }}
					<span class="stat"><strong>{{ .TotalFiles }}</strong> matching file{{ if ne .TotalFiles 1 }}s{{ end }} (of {{ .TotalUnfiltered }})</span>
				{{ else }}
					<span class="stat"><strong>{{ .TotalFiles }}</strong> file{{ if ne .TotalFiles 1 }}s{{ end }}</span>
				{{ end }}
				{{ if and (or $.IsAdmin $.IsSelf) (not .PendingPurge) }}
					<button type="button" class="act danger" commandfor="purgedlg" command="show-modal" data-purge-id="{{ .Token.ID }}">Purge All Media</button>
				{{ end }}
			</div>
			<form class="search-box" method="GET" action="" id="searchForm">
				<svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input type="search" name="q" id="searchInput" value="{{ .Query }}" placeholder="Search all files…" aria-label="Search files" autocomplete="off" spellcheck="false" />
				{{ if .Query }}
					<button type="button" id="searchClear" commandfor="searchForm" command="--clear-search" class="search-clear-btn" aria-label="Clear search">&times;</button>
				{{ end }}
			</form>
		</div>
		{{ if .Uploads }}
			<div class="file-list" id="fileList" data-page="{{ .Page }}" data-total-pages="{{ .TotalPages }}" data-token-id="{{ .Token.ID }}" data-query="{{ .Query }}">
				<div class="file-header">
					<span class="fh-preview"></span>
					<span class="fh-name">Name</span>
					<span class="fh-type">Type</span>
					<span class="fh-size">Size</span>
					<span class="fh-date">Uploaded</span>
					{{ if or $.IsAdmin $.IsSelf }}
						<span class="fh-actions"></span>
					{{ end }}
				</div>

				{{ range .Uploads }}
					<div class="file-row">
						<button type="button" class="file-preview" {{ if isMedia .Name }}commandfor="imgModal" command="show-modal"{{ end }} data-preview-url="{{ fileURL $.BaseURL .Name $.StripExtension }}" data-file-name="{{ stripExt .Name }}" data-raw-name="{{ .Name }}" data-is-media="{{ if isMedia .Name }}true{{ else }}false{{ end }}" data-media-type="{{ mediaType .Name }}">
							{{ if isImage .Name }}
								<img src="{{ fileURL $.BaseURL .Name $.StripExtension }}" loading="lazy" alt="{{ stripExt .Name }}">
							{{ else }}
								<span class="file-icon-fallback">{{ fileIcon .Name }}</span>
							{{ end }}
						</button>
						<span class="file-name"><a href="{{ fileURL $.BaseURL .Name $.StripExtension }}" target="_blank" rel="noopener">{{ stripExt .Name }}</a></span>
						<span class="file-ext"><span class="ext-badge">{{ fileExt .Name }}</span></span>
						<span class="file-size">{{ humanBytes .Size }}</span>
						<span class="file-date">{{ fmtDate .UploadedAt }}</span>
						{{ if or $.IsAdmin $.IsSelf }}
							<span class="file-actions">
								<button type="button" class="act danger icon-btn" commandfor="filedel-dlg" command="show-modal" data-delete-filename="{{ .Name }}" title="Delete file">🗑️</button>
							</span>
						{{ end }}
					</div>
				{{ end }}
			</div>

			{{ if gt .TotalPages 1 }}
				<div class="pager-bar">
					<div>Showing <strong>{{ .PageStart }}–{{ .PageEnd }}</strong> of <strong>{{ .TotalFiles }}</strong> files</div>
					<div class="pager-controls">
						{{ if gt .Page 1 }}
							<a href="{{ pageURL (sub .Page 1) .Query }}" class="pager-btn">Prev</a>
						{{ else }}
							<span class="pager-btn" disabled>Prev</span>
						{{ end }}

						{{ $cur := .Page }}
						{{ $max := .TotalPages }}
						{{ $q := .Query }}
						{{ $prev := 0 }}
						{{ range $p := pageRange $cur $max }}
							{{ if gt (sub $p $prev) 1 }}
								<span class="pager-dots">…</span>
							{{ end }}
							{{ if eq $p $cur }}
								<span class="pager-btn active">{{ $p }}</span>
							{{ else }}
								<a href="{{ pageURL $p $q }}" class="pager-btn">{{ $p }}</a>
							{{ end }}
							{{ $prev = $p }}
						{{ end }}

						{{ if lt .Page .TotalPages }}
							<a href="{{ pageURL (add .Page 1) .Query }}" class="pager-btn">Next</a>
						{{ else }}
							<span class="pager-btn" disabled>Next</span>
						{{ end }}
					</div>
				</div>
			{{ end }}
		{{ else }}
			<div class="file-list">
				{{ if .Query }}
					<div class="empty-state">No files matching "{{ .Query }}".</div>
				{{ else }}
					<div class="empty-state">No uploads recorded yet.</div>
				{{ end }}
			</div>
		{{ end }}
		<dialog id="imgModal" class="lightbox-dialog" tabindex="-1" autofocus>
			<button type="button" id="modalPrev" commandfor="imgModal" command="--prev" class="lightbox-nav-btn nav-prev" aria-label="Previous file">
				<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
			</button>
			<button type="button" id="modalNext" commandfor="imgModal" command="--next" class="lightbox-nav-btn nav-next" aria-label="Next file">
				<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
			</button>
			<div class="lightbox-content">
				<div class="lightbox-stage">
					<img id="modalImg" class="lightbox-img hidden" src="" alt="Preview">
					<div id="modalVideoBox" class="lightbox-video-box hidden">
						<video id="modalVideo" class="lightbox-video" playsinline preload="metadata"></video>
						<div class="video-center-flash" id="videoCenterFlash">
							<svg class="flash-play hidden" viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><polygon points="6 4 19 12 6 20"></polygon></svg>
							<svg class="flash-pause hidden" viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
						</div>
						<div class="custom-player-controls video-controls" id="videoControls">
							<div class="player-timeline-box" id="videoTimelineBox">
								<div class="player-timeline" id="videoTimeline">
									<div class="player-buffered" id="videoBuffered"></div>
									<div class="player-progress" id="videoProgress"></div>
									<div class="player-thumb" id="videoThumb"></div>
								</div>
							</div>
							<div class="player-button-row">
								<div class="player-btns-left">
									<button type="button" class="player-btn" id="videoPlayBtn" title="Play / Pause (Space)">
										<svg class="play-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><polygon points="6 4 19 12 6 20"></polygon></svg>
										<svg class="pause-icon hidden" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
									</button>
									<button type="button" class="player-btn player-btn-skip" id="videoBackBtn" title="Rewind 10s (←)">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4v6h6"></path><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
									</button>
									<button type="button" class="player-btn player-btn-skip" id="videoFwdBtn" title="Forward 10s (→)">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"></path><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
									</button>
									<div class="player-vol-container">
										<button type="button" class="player-btn" id="videoMuteBtn" title="Mute (M)">
											<svg class="vol-high-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
											<svg class="vol-mute-icon hidden" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
										</button>
										<input type="range" class="player-vol-slider" id="videoVolSlider" min="0" max="1" step="0.05" value="1" title="Volume">
									</div>
									<div class="player-time">
										<span id="videoCurTime">0:00</span> / <span id="videoDurTime">0:00</span>
									</div>
								</div>
								<div class="player-btns-right">
									<button type="button" class="player-btn player-rate-btn" id="videoRateBtn" title="Playback speed">1x</button>
									<button type="button" class="player-btn player-btn-aux" id="videoLoopBtn" title="Toggle loop">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
									</button>
									<button type="button" class="player-btn player-btn-aux" id="videoPipBtn" title="Picture-in-Picture (P)">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"></rect><rect x="12" y="9" width="8" height="6" rx="1"></rect></svg>
									</button>
									<button type="button" class="player-btn" id="videoFullscreenBtn" title="Fullscreen (F)">
										<svg class="fs-enter-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
										<svg class="fs-exit-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path></svg>
									</button>
								</div>
							</div>
						</div>
					</div>
					<div id="modalAudioBox" class="lightbox-audio-box hidden">
						<div class="audio-visual">
							<div class="audio-disc" id="audioDisc">
								<svg viewBox="0 0 24 24" width="60" height="60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"></circle>
									<circle cx="12" cy="12" r="3"></circle>
									<path d="M12 2a10 10 0 0 1 10 10"></path>
								</svg>
							</div>
							<div class="audio-meta">
								<div id="modalAudioName" class="audio-filename"></div>
							</div>
						</div>
						<audio id="modalAudio" preload="metadata"></audio>
						<div class="custom-player-controls audio-controls">
							<div class="player-timeline-box" id="audioTimelineBox">
								<div class="player-timeline" id="audioTimeline">
									<div class="player-buffered" id="audioBuffered"></div>
									<div class="player-progress" id="audioProgress"></div>
									<div class="player-thumb" id="audioThumb"></div>
								</div>
								<div class="player-time">
									<span id="audioCurTime">0:00</span> / <span id="audioDurTime">0:00</span>
								</div>
							</div>
							<div class="player-button-row">
								<div class="player-btns-left">
									<button type="button" class="player-btn player-btn-skip" id="audioBackBtn" title="Rewind 10s">
										<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4v6h6"></path><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
									</button>
									<button type="button" class="player-btn player-btn-main" id="audioPlayBtn" title="Play / Pause (Space)">
										<svg class="play-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><polygon points="6 4 19 12 6 20"></polygon></svg>
										<svg class="pause-icon hidden" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
									</button>
									<button type="button" class="player-btn player-btn-skip" id="audioFwdBtn" title="Forward 10s">
										<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"></path><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
									</button>
								</div>
								<div class="player-btns-right">
									<button type="button" class="player-btn player-rate-btn" id="audioRateBtn" title="Playback speed">1x</button>
									<button type="button" class="player-btn" id="audioLoopBtn" title="Toggle loop">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
									</button>
									<div class="player-vol-container">
										<button type="button" class="player-btn" id="audioMuteBtn" title="Mute (M)">
											<svg class="vol-high-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
											<svg class="vol-mute-icon hidden" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
										</button>
										<input type="range" class="player-vol-slider" id="audioVolSlider" min="0" max="1" step="0.05" value="1" title="Volume">
									</div>
								</div>
							</div>
						</div>
					</div>
					<div id="modalTextBox" class="lightbox-text-box hidden">
						<div class="text-preview-header">
							<div class="text-preview-meta">
								<span id="textTypeBadge" class="text-type-badge">TXT</span>
								<span id="textStats" class="text-stats"></span>
							</div>
							<div class="text-preview-actions">
								<button type="button" id="textWrapBtn" class="text-act-btn" title="Toggle word wrap">Wrap: Off</button>
								<button type="button" id="textCopyBtn" class="text-act-btn" title="Copy text content">Copy</button>
							</div>
						</div>
						<div id="textLoading" class="text-state-box text-loading hidden">
							<div class="spinner"></div>
							<span>Loading text preview…</span>
						</div>
						<div id="textError" class="text-state-box text-error hidden">
							<span id="textErrorMsg">Unable to display preview.</span>
						</div>
						<div id="textScrollArea" class="text-scroll-area hidden">
							<div id="textLineNumbers" class="text-line-numbers" aria-hidden="true"></div>
							<pre id="modalTextPre" class="text-pre"><code id="modalTextCode" class="text-code"></code></pre>
						</div>
					</div>
					<iframe id="modalPdf" class="lightbox-pdf hidden" src="about:blank" title="PDF Preview"></iframe>
					<div id="modalFontBox" class="lightbox-font-box hidden">
						<div class="font-preview-header">
							<span id="fontFamilyName" class="font-family-name"></span>
							<span id="fontFormatBadge" class="font-format-badge">TTF</span>
						</div>
						<div class="font-sample-scroll">
							<div class="font-sample-alphabet">
								ABCDEFGHIJKLMNOPQRSTUVWXYZ<br>
								abcdefghijklmnopqrstuvwxyz<br>
								0123456789 (!@#$%^&amp;*()_+-=[]{}|;:,.<>?)
								</div>
								<div class="font-sample-headline">
									The quick brown fox jumps over the lazy dog
								</div>
								<div class="font-sample-paragraph">
									Pack my box with five dozen liquor jugs. Sphinx of black quartz, judge my vow. Two driven jocks help fax my big quiz.
								</div>
							</div>
						</div>
					</div>
					<div class="lightbox-footer">
						<div class="lightbox-info">
							<span id="modalTitle" class="mono"></span>
						</div>
						<div class="lightbox-actions">
							<a id="modalDownload" href="" target="_blank" rel="noopener" class="act-btn">Open Original</a>
							{{ if or $.IsAdmin $.IsSelf }}
								<input type="hidden" id="modalDeleteFilename" value="">
								<button type="button" id="modalDeleteBtn" commandfor="filedel-dlg" command="show-modal" class="act-btn danger">Delete File</button>
							{{ end }}
							<button type="button" id="modalClose" commandfor="imgModal" command="close" class="act-btn">Close</button>
						</div>
					</div>
				</div>
			</dialog>

			<dialog id="filedel-dlg" tabindex="-1" autofocus>
				<form method="POST" action="/_/files/delete" id="filedel-form">
					<input type="hidden" name="_csrf" value="{{ .CSRF }}">
					<input type="hidden" name="filename" id="filedel-input" value="">
					<p id="filedel-msg">Delete file permanently?</p>
					<div class="bar bar-end">
						<button type="button" commandfor="filedel-dlg" command="close">Cancel</button>
						<button type="submit" class="danger">Delete File</button>
					</div>
				</form>
			</dialog>

			<dialog id="purgedlg" tabindex="-1" autofocus>
				<form method="POST" id="purgeForm" action="">
					<input type="hidden" name="_csrf" value="{{ .CSRF }}">
					<p id="purgedlgmsg"></p>
					<label class="dlg-label">Type <code id="purgeTargetPhrase"></code> to confirm
						<input type="text" name="confirm_phrase" id="purgeConfirmInput"
							autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
							onpaste="return false;" ondrop="return false;" required>
					</label>
					<div id="purgePasteWarning" class="label-err" hidden>pasting is disabled</div>
					<div class="bar bar-end">
						<button type="button" commandfor="purgedlg" command="close">Cancel</button>
						<button type="button" class="danger" id="purgeSubmitBtn" commandfor="purgedlg" command="--submit-purge" disabled>Purge</button>
					</div>
				</form>
			</dialog>

		<script type="module" src="/_/uploads/js/uploads.bundle.js"></script>
		</body>
	</html>
