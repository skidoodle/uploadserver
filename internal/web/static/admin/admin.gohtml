<!doctype html>
<html lang="en">

	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<link rel="icon" href="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
		<title>{{ if .LoggedIn }}uploadserver · admin{{ else }}uploadserver{{ end }}</title>
		{{ if .LoggedIn }}
			<link rel="stylesheet" href="/_/admin/css/admin.bundle.css" />
		{{ else }}
			<link rel="stylesheet" href="/_/login/css/login.bundle.css" />
		{{ end }}
	</head>

	<body>
		<h1>uploadserver</h1>
		{{ if .LoggedIn }}
			{{ template "dashboard" . }}
    <script type="module" src="/_/admin/js/admin.bundle.js"></script>
		{{ else }}
			{{ template "login" . }}
    <script type="module" src="/_/login/js/login.bundle.js"></script>
		{{ end }}
	</body>
</html>
