<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<link rel="icon" href="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
		<title>uploadserver · {{ .Token.Label }} uploads</title>
		<link rel="stylesheet" href="/_/admin.css" />
		<link rel="stylesheet" href="/_/uploads.css" />
	</head>
	<body>
		<h1>uploadserver</h1>
		<nav class="breadcrumb">
			<a href="/">dashboard</a>
			<span class="sep">›</span>
			<span>uploads</span>
			<span class="sep">›</span>
			<span>{{ .Token.ID }}</span>
		</nav>

		{{ if .Notice }}
			<div class="notice">{{ .Notice }}</div>
		{{ end }}
		{{ if .Error }}
			<p id="msg" class="err">{{ .Error }}</p>
		{{ end }}

		{{ if .PendingPurge }}
			<div class="purge-banner">
				<span>Media purge scheduled in <strong>{{ timeUntil .PendingPurge.PurgeAt }}</strong> ({{ fmtDate .PendingPurge.PurgeAt }})</span>
				<form method="POST" action="/_/tokens/{{ .Token.ID }}/cancel-purge">
					<input type="hidden" name="_csrf" value="{{ .CSRF }}">
					<button type="submit" class="act">Cancel purge</button>
				</form>
			</div>
		{{ end }}

		<div class="toolbar-bar">
			<div class="summary-bar">
				{{ if gt .TotalUnfiltered 0 }}
					<span class="stat"><strong>{{ .TotalFiles }}</strong> matching file{{ if ne .TotalFiles 1 }}s{{ end }} (of {{ .TotalUnfiltered }})</span>
				{{ else }}
					<span class="stat"><strong>{{ .TotalFiles }}</strong> file{{ if ne .TotalFiles 1 }}s{{ end }}</span>
				{{ end }}
				{{ if and (or $.IsAdmin $.IsSelf) (not .PendingPurge) }}
					<button type="button" class="act danger" commandfor="purgedlg" command="show-modal" data-purge-id="{{ .Token.ID }}">Purge All Media</button>
				{{ end }}
			</div>
			<form class="search-box" method="GET" action="" id="searchForm">
				<svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input type="search" name="q" id="searchInput" value="{{ .Query }}" placeholder="Search all files…" aria-label="Search files" autocomplete="off" spellcheck="false" />
				{{ if .Query }}
					<button type="button" id="searchClear" commandfor="searchForm" command="--clear-search" class="search-clear-btn" aria-label="Clear search">&times;</button>
				{{ end }}
			</form>
		</div>
		{{ if .Uploads }}
			<div class="file-list" id="fileList" data-page="{{ .Page }}" data-total-pages="{{ .TotalPages }}" data-token-id="{{ .Token.ID }}" data-query="{{ .Query }}">
				<div class="file-header">
					<span class="fh-preview"></span>
					<span class="fh-name">Name</span>
					<span class="fh-type">Type</span>
					<span class="fh-size">Size</span>
					<span class="fh-date">Uploaded</span>
					{{ if or $.IsAdmin $.IsSelf }}
						<span class="fh-actions"></span>
					{{ end }}
				</div>

				{{ range .Uploads }}
					<div class="file-row">
						<button type="button" class="file-preview" {{ if isMedia .Name }}commandfor="imgModal" command="show-modal"{{ end }} data-preview-url="{{ fileURL $.BaseURL .Name $.StripExtension }}" data-file-name="{{ stripExt .Name }}" data-raw-name="{{ .Name }}" data-is-media="{{ if isMedia .Name }}true{{ else }}false{{ end }}" data-media-type="{{ if isVideo .Name }}video{{ else if isImage .Name }}image{{ else }}other{{ end }}">
							{{ if isImage .Name }}
								<img src="{{ fileURL $.BaseURL .Name $.StripExtension }}" loading="lazy" alt="{{ stripExt .Name }}">
							{{ else if isVideo .Name }}
								<span class="file-icon-fallback">🎥</span>
							{{ else }}
								<span class="file-icon-fallback">{{ fileIcon .Name }}</span>
							{{ end }}
						</button>
						<span class="file-name"><a href="{{ fileURL $.BaseURL .Name $.StripExtension }}" target="_blank" rel="noopener">{{ stripExt .Name }}</a></span>
						<span class="file-ext"><span class="ext-badge">{{ fileExt .Name }}</span></span>
						<span class="file-size">{{ humanBytes .Size }}</span>
						<span class="file-date">{{ fmtDate .UploadedAt }}</span>
						{{ if or $.IsAdmin $.IsSelf }}
							<span class="file-actions">
								<button type="button" class="act danger icon-btn" commandfor="filedel-dlg" command="show-modal" data-delete-filename="{{ .Name }}" title="Delete file">🗑️</button>
							</span>
						{{ end }}
					</div>
				{{ end }}
			</div>

			{{ if gt .TotalPages 1 }}
				<div class="pager-bar">
					<div>Showing <strong>{{ .PageStart }}–{{ .PageEnd }}</strong> of <strong>{{ .TotalFiles }}</strong> files</div>
					<div class="pager-controls">
						{{ if gt .Page 1 }}
							<a href="{{ pageURL (sub .Page 1) .Query }}" class="pager-btn">Prev</a>
						{{ else }}
							<span class="pager-btn" disabled>Prev</span>
						{{ end }}

						{{ $cur := .Page }}
						{{ $max := .TotalPages }}
						{{ $q := .Query }}
						{{ $prev := 0 }}
						{{ range $p := pageRange $cur $max }}
							{{ if gt (sub $p $prev) 1 }}
								<span class="pager-dots">…</span>
							{{ end }}
							{{ if eq $p $cur }}
								<span class="pager-btn active">{{ $p }}</span>
							{{ else }}
								<a href="{{ pageURL $p $q }}" class="pager-btn">{{ $p }}</a>
							{{ end }}
							{{ $prev = $p }}
						{{ end }}

						{{ if lt .Page .TotalPages }}
							<a href="{{ pageURL (add .Page 1) .Query }}" class="pager-btn">Next</a>
						{{ else }}
							<span class="pager-btn" disabled>Next</span>
						{{ end }}
					</div>
				</div>
			{{ end }}
		{{ else }}
			<div class="file-list">
				{{ if .Query }}
					<div class="empty-state">No files matching "{{ .Query }}".</div>
				{{ else }}
					<div class="empty-state">No uploads recorded yet.</div>
				{{ end }}
			</div>
		{{ end }}
		<dialog id="imgModal" class="lightbox-dialog">
			<button type="button" id="modalPrev" commandfor="imgModal" command="--prev" class="lightbox-nav-btn nav-prev" aria-label="Previous image">
				<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
			</button>
			<button type="button" id="modalNext" commandfor="imgModal" command="--next" class="lightbox-nav-btn nav-next" aria-label="Next image">
				<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
			</button>
			<div class="lightbox-content">
				<div class="lightbox-stage">
					<img id="modalImg" class="lightbox-img" src="" alt="Preview">
					<video id="modalVideo" class="lightbox-video hidden" controls playsinline></video>
				</div>
				<div class="lightbox-footer">
					<div class="lightbox-info">
						<span id="modalTitle" class="mono"></span>
					</div>
					<div class="lightbox-actions">
						<a id="modalDownload" href="" target="_blank" rel="noopener" class="act-btn">Open Original</a>
						{{ if or $.IsAdmin $.IsSelf }}
							<input type="hidden" id="modalDeleteFilename" value="">
							<button type="button" id="modalDeleteBtn" commandfor="filedel-dlg" command="show-modal" class="act-btn danger">Delete File</button>
						{{ end }}
						<button type="button" id="modalClose" commandfor="imgModal" command="close" class="act-btn">Close</button>
					</div>
				</div>
			</div>
		</dialog>

		<dialog id="filedel-dlg">
			<form method="POST" action="/_/files/delete" id="filedel-form">
				<input type="hidden" name="_csrf" value="{{ .CSRF }}">
				<input type="hidden" name="filename" id="filedel-input" value="">
				<p id="filedel-msg">Delete file permanently?</p>
				<div class="bar bar-end">
					<button type="button" commandfor="filedel-dlg" command="close">Cancel</button>
					<button type="submit" class="danger">Delete File</button>
				</div>
			</form>
		</dialog>

		<dialog id="purgedlg">
			<form method="POST" id="purgeForm" action="">
				<input type="hidden" name="_csrf" value="{{ .CSRF }}">
				<p id="purgedlgmsg"></p>
				<label class="dlg-label">Type <code id="purgeTargetPhrase"></code> to confirm
					<input type="text" name="confirm_phrase" id="purgeConfirmInput"
						autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
						onpaste="return false;" ondrop="return false;" required>
				</label>
				<div id="purgePasteWarning" class="label-err" hidden>pasting is disabled</div>
				<div class="bar bar-end">
					<button type="button" commandfor="purgedlg" command="close">Cancel</button>
					<button type="button" class="danger" id="purgeSubmitBtn" commandfor="purgedlg" command="--submit-purge" disabled>Purge</button>
				</div>
			</form>
		</dialog>

		<script src="/_/admin.js"></script>
		<script src="/_/uploads.js"></script>
	</body>
</html>
