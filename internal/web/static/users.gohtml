<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<link rel="icon" href="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
		<title>uploadserver · users</title>
		<link rel="stylesheet" href="/_/admin.css" />
		<link rel="stylesheet" href="/_/uploads.css" />
	</head>
	<body>
		<h1>uploadserver</h1>
		<nav class="breadcrumb">
			<a href="/">dashboard</a>
			<span class="sep">›</span>
			<span>users</span>
		</nav>

		{{ if .Secret }}
			<div class="secret" id="secretCard">
				<button type="button" class="secret-close" title="Dismiss" commandfor="secretCard" command="--dismiss">&times;</button>
				New {{ .Secret.Role }} token <code>{{ .Secret.ID }}</code> &#8212; shown once:
				<div class="srow">
					<span id="sv" class="mono blurred">{{ .Secret.Secret }}</span>
					<button type="button" id="reveal" class="act" title="Reveal token" commandfor="secretCard" command="--toggle-blur">Show</button>
					<button type="button" id="cp" class="act" commandfor="secretCard" command="--copy">Copy</button>
					<button type="button" id="dl-sxcu" class="act" commandfor="secretCard" command="--download-sxcu" data-token-id="{{ .Secret.ID }}">Download .sxcu</button>
				</div>
			</div>
		{{ end }}

		{{ if .Notice }}
			<div class="notice">{{ .Notice }}</div>
		{{ end }}
		{{ if .Error }}
			<p id="msg" class="err">{{ .Error }}</p>
		{{ end }}

		<fieldset>
			<legend>create token</legend>
			<form method="POST" action="/_/tokens/create" class="bar">
				<input type="hidden" name="_csrf" value="{{ .CSRF }}">
				<input name="label" placeholder="label (e.g. laptop)" required
					pattern="^[a-zA-Z0-9]([a-zA-Z0-9_-]{0,7}[a-zA-Z0-9])?$"
					title="1-9 alphanumeric characters (can contain _ or - inside).">
				<div class="csel" id="roleSel">
					<button type="button" class="csel-btn" id="roleBtn" commandfor="roleSel" command="--toggle-select">role: upload</button>
					<div class="csel-opts" id="roleOpts">
						<div class="csel-opt active" data-value="upload">role: upload</div>
						<div class="csel-opt" data-value="admin">role: admin</div>
					</div>
				</div>
				<input type="hidden" name="role" id="role" value="upload">
				<button type="submit">Create</button>
				<button type="button" id="giveawayBtn" commandfor="giveawaydlg" command="show-modal">Giveaway Invites</button>
			</form>
			<div id="label-err" class="label-err" hidden></div>
		</fieldset>

		<div class="toolbar-bar">
			<div class="summary-bar">
				{{ if gt .TotalUnfiltered 0 }}
					<span class="stat"><strong>{{ .Count }}</strong> matching user{{ if ne .Count 1 }}s{{ end }} (of {{ .TotalUnfiltered }})</span>
				{{ else }}
					<span class="stat"><strong>{{ .Count }}</strong> user{{ if ne .Count 1 }}s{{ end }}</span>
				{{ end }}
			</div>
			<form class="search-box" method="GET" action="" id="searchForm">
				<svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input type="search" name="q" id="searchInput" value="{{ .Query }}" placeholder="Search all users…" aria-label="Search users" autocomplete="off" spellcheck="false" />
				{{ if .Query }}
					<button type="button" id="searchClear" commandfor="searchForm" command="--clear-search" class="search-clear-btn" aria-label="Clear search">&times;</button>
				{{ end }}
			</form>
		</div>

		{{ if .Tokens }}
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Label</th>
						<th>Role</th>
						<th>Status</th>
						<th>Created</th>
						<th>Last used</th>
						<th>Usage</th>
						<th class="ctx-col"></th>
					</tr>
				</thead>
				<tbody>
					{{ range .Tokens }}
						<tr class="{{ if .Disabled }}off{{ end }} {{ if eq .ID $.CurrentToken.ID }}me{{ end }} {{ if index $.PendingPurges .ID }}purging{{ end }}">
							<td data-label="ID"><a href="/_/user/{{ .ID }}" class="id-link"><code>{{ .ID }}</code></a></td>
							<td data-label="Label">{{ .Label }}</td>
							<td data-label="Role">{{ .Role }}</td>
							<td data-label="Status">{{ if .Disabled }}disabled{{ else }}active{{ end }}{{ if index $.PendingPurges .ID }}, purging{{ end }}</td>
							<td data-label="Created">{{ fmtDate .CreatedAt }}</td>
							<td data-label="Last used">{{ with fmtDate .LastUsed }}{{ . }}{{ else }}<span class="dim">never</span>{{ end }}</td>
							<td data-label="Usage" class="usage">{{ $eff := effective .Limits $.Global .BypassesGlobal }}
								{{ if or .Usage.Uploads $eff.Any
									.Bypass
								}}<span class="u-line">{{ comma .Usage.Uploads }}
										{{ if $eff.MaxUploads }} <span class="dim">/ {{ comma
	$eff.MaxUploads
}}</span>
										{{ else if .Bypass }} <span class="dim">/ ∞</span>
										{{ end }} uploads</span><span class="u-line dim">{{ humanBytes
	.Usage.Bytes
}}{{ if $eff.MaxBytes }} / {{ humanBytes $eff.MaxBytes }}{{ else if .Bypass }} / ∞{{ end }}</span>
								{{ else }}<span class="dim">none</span>
								{{ end }}</td>
							<td class="ctx-col">
								{{ if ne .Role "root" }}<div class="ctx" id="ctx-{{ .ID }}">
										<button type="button" class="ctx-trigger" commandfor="ctx-{{ .ID }}" command="--toggle-menu" aria-label="Actions">⋯</button>
										<div class="ctx-menu">
											<a href="/_/user/{{ .ID }}" class="ctx-item">Profile</a>
											<a href="/_/uploads/{{ .ID }}" class="ctx-item">Files</a>
											<button type="button" class="ctx-item" commandfor="renamedlg" command="show-modal" data-rename-id="{{ .ID }}" data-label="{{ .Label }}">Rename</button>
											<button type="button" class="ctx-item" commandfor="limdlg" command="show-modal" data-limit-id="{{ .ID }}"
												data-max-bytes="{{ with .Limits.MaxBytes }}{{ humanBytes . }}{{ end }}"
												data-max-uploads="{{ with .Limits.MaxUploads }}{{ . }}{{ end }}"
												data-monthly-bytes="{{ with .Limits.MonthlyBytes }}{{ humanBytes . }}{{ end }}"
												data-monthly-uploads="{{ with .Limits.MonthlyUploads }}{{ . }}{{ end }}"
												data-invites="{{ with .Invites }}{{ . }}{{ end }}"
												data-bypass="{{ if .Bypass }}1{{ end }}">Limits & Invites</button>
											<form method="POST" action="/_/tokens/{{ .ID }}/toggle" class="ctx-form">
												<input type="hidden" name="_csrf" value="{{ $.CSRF }}">
												<input type="hidden" name="disable" value="{{ if .Disabled }}false{{ else }}true{{ end }}">
												<button class="ctx-item" type="submit">{{ if .Disabled }}Enable{{ else }}Disable{{ end }}</button>
											</form>
											{{ if $.IsRoot }}
												{{ if eq .Role "admin" }}
													<button type="button" class="ctx-item" commandfor="roledlg" command="show-modal" data-role-id="{{ .ID }}" data-role-target="upload" data-role-label="Demote to Uploader">Demote to Uploader</button>
												{{ else if eq .Role "upload" }}
													<button type="button" class="ctx-item" commandfor="roledlg" command="show-modal" data-role-id="{{ .ID }}" data-role-target="admin" data-role-label="Promote to Admin">Promote to Admin</button>
												{{ end }}
											{{ end }}
											<div class="ctx-sep"></div>
											<button type="button" class="ctx-item ctx-danger" commandfor="dlg" command="show-modal" data-delete-id="{{ .ID }}">Delete</button>
										</div>
									</div>
								{{ end }}
							</td>
						</tr>
					{{ end }}
				</tbody>
			</table>

			{{ if gt .TotalPages 1 }}
				<div class="pager-bar">
					<div>Showing <strong>{{ .PageStart }}–{{ .PageEnd }}</strong> of <strong>{{ .Count }}</strong> users</div>
					<div class="pager-controls">
						{{ if gt .Page 1 }}
							<a href="{{ pageURL (sub .Page 1) .Query }}" class="pager-btn">Prev</a>
						{{ else }}
							<span class="pager-btn" disabled>Prev</span>
						{{ end }}

						{{ $cur := .Page }}
						{{ $max := .TotalPages }}
						{{ $q := .Query }}
						{{ $prev := 0 }}
						{{ range $p := pageRange $cur $max }}
							{{ if gt (sub $p $prev) 1 }}
								<span class="pager-dots">…</span>
							{{ end }}
							{{ if eq $p $cur }}
								<span class="pager-btn active">{{ $p }}</span>
							{{ else }}
								<a href="{{ pageURL $p $q }}" class="pager-btn">{{ $p }}</a>
							{{ end }}
							{{ $prev = $p }}
						{{ end }}

						{{ if lt .Page .TotalPages }}
							<a href="{{ pageURL (add .Page 1) .Query }}" class="pager-btn">Next</a>
						{{ else }}
							<span class="pager-btn" disabled>Next</span>
						{{ end }}
					</div>
				</div>
			{{ end }}
		{{ else }}
			<div class="empty-state">No users found.</div>
		{{ end }}

		<dialog id="dlg">
			<form method="POST" id="dlgForm" action="">
				<input type="hidden" name="_csrf" value="{{ .CSRF }}">
				<p id="dlgmsg"></p>
				<div class="bar bar-end">
					<button type="button" commandfor="dlg" command="close">Cancel</button>
					<button type="submit" class="danger">Delete</button>
				</div>
			</form>
		</dialog>

		<dialog id="roledlg">
			<form method="POST" id="roleForm" action="">
				<input type="hidden" name="_csrf" value="{{ .CSRF }}">
				<input type="hidden" name="role" id="roleTargetInput" value="">
				<p id="roledlgmsg"></p>
				<div class="bar bar-end">
					<button type="button" commandfor="roledlg" command="close">Cancel</button>
					<button type="submit">Confirm</button>
				</div>
			</form>
		</dialog>

		<dialog id="limdlg">
			<form method="POST" id="limForm" action="">
				<input type="hidden" name="_csrf" value="{{ .CSRF }}">
				<p>Quotas & Invites for <code id="limTarget"></code></p>
				<div class="lim-grid">
					<label>Total size<input name="max_bytes" data-kind="size" placeholder="unlimited" autocomplete="off"></label>
					<label>Total uploads<input name="max_uploads" data-kind="count" placeholder="unlimited"
							autocomplete="off">
					</label>
					<label>Monthly size<input name="monthly_bytes" data-kind="size" placeholder="unlimited"
							autocomplete="off">
					</label>
					<label>Monthly uploads<input name="monthly_uploads" data-kind="count" placeholder="unlimited"
							autocomplete="off">
					</label>
					<label>Invite quota<input name="invites" type="number" min="0" placeholder="0" autocomplete="off"></label>
				</div>
				<label class="lim-check"><input type="checkbox" name="bypass" id="limBypass" value="true"> Exempt this token from
					all quotas
				</label>
				<p class="dim lim-hint">Blank or 0 means unlimited/none. Personal caps override global defaults.</p>
				<div id="lim-err" class="quota-err"></div>
				<div class="bar bar-end">
					<button type="button" commandfor="limdlg" command="close">Cancel</button>
					<button type="submit">Save</button>
				</div>
			</form>
		</dialog>

		<dialog id="renamedlg">
			<form method="POST" id="renameForm" action="">
				<input type="hidden" name="_csrf" value="{{ .CSRF }}">
				<p class="dlg-title">Rename token <code id="renameTarget"></code></p>
				<label class="dlg-label">New Label
					<input name="label" id="renameInput" required
						pattern="^[a-zA-Z0-9]([a-zA-Z0-9_-]{0,7}[a-zA-Z0-9])?$"
						title="1-9 alphanumeric characters (can contain _ or - inside).">
				</label>
				<div id="rename-err" class="label-err" hidden></div>
				<div class="bar bar-end">
					<button type="button" commandfor="renamedlg" command="close">Cancel</button>
					<button type="submit">Save</button>
				</div>
			</form>
		</dialog>

		<dialog id="giveawaydlg">
			<form method="POST" action="/_/tokens/giveaway">
				<input type="hidden" name="_csrf" value="{{ .CSRF }}">
				<p class="dlg-title">Giveaway Invites</p>
				<p class="dlg-desc">Grant additional invite credits to users with the <code>upload</code> role.</p>
				<div class="lim-grid" style="margin-bottom: 0.8rem;">
					<div class="dlg-label">
						<span>Target</span>
						<div class="csel" id="giveawayModeSel">
							<button type="button" class="csel-btn" id="giveawayModeBtn" commandfor="giveawayModeSel" command="--toggle-select">All uploaders</button>
							<div class="csel-opts" id="giveawayModeOpts">
								<div class="csel-opt active" data-value="all">All uploaders</div>
								<div class="csel-opt" data-value="random">Random pool</div>
							</div>
						</div>
						<input type="hidden" name="mode" id="giveawayMode" value="all">
					</div>
					<label class="dlg-label">Invites per user
						<input type="number" name="count" min="1" max="1000" value="1" required>
					</label>
					<label class="dlg-label" id="giveawayPoolGroup" hidden>Pool size (users)
						<input type="number" name="pool" min="1" max="10000" value="5">
					</label>
					<label class="dlg-label">Max cap (0 = unlimited)
						<input type="number" name="max_cap" min="0" max="10000" value="0" placeholder="0">
					</label>
				</div>
				<div class="bar bar-end">
					<button type="button" commandfor="giveawaydlg" command="close">Cancel</button>
					<button type="submit">Grant Invites</button>
				</div>
			</form>
		</dialog>

    <script src="/_/admin.js"></script>
	</body>
</html>
